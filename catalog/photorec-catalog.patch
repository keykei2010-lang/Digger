+static void catalog_window(disk_t *disk, unsigned char *buf, uint64_t offset)
+{
+  uint64_t left=offset<disk->disk_real_size?disk->disk_real_size-offset:0;
+  unsigned int want=left<READ_SIZE?(unsigned int)left:READ_SIZE;
+  if(want<READ_SIZE) memset(buf+want,0,READ_SIZE-want);
+  if(want && disk->pread(disk,buf,want,offset)!=(int)want) {
+    unsigned int step=disk->sector_size;
+    for(unsigned int i=0;i<want;i+=step) {
+      unsigned int n=want-i<step?want-i:step;
+      if(disk->pread(disk,buf+i,n,offset+i)!=(int)n) {
+        memset(buf+i,0,n);
+        if(i==0 || i+step==want) printf("DGREADERR\t%llu\n",(unsigned long long)(offset+i));
+      }
+    }
+    puts("DGREADERR"); fflush(stdout);
+  }
+}
