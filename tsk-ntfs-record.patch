+// Keep allocation state and record identity independent of the human-readable report.
+static int ntfs_record_status(TSK_FS_INFO *fs, TSK_INUM_T inum)
+{
+    TSK_FS_FILE *file = tsk_fs_file_open_meta(fs, NULL, inum);
+    if (!file) return 1;
+    const auto *meta = file->meta;
+    if (!meta) {
+        tsk_fs_file_close(file);
+        return 1;
+    }
+    const char *state = (meta->flags & TSK_FS_META_FLAG_ALLOC) ? "allocated" :
+        (!(meta->flags & TSK_FS_META_FLAG_UNALLOC) ? "unknown" :
+         (meta->type == TSK_FS_META_TYPE_REG ? "deleted-file" : "other"));
+    printf("RECORD %" PRIuINUM " %" PRIu32 " %s\n", meta->addr, meta->seq, state);
+    if (meta->type == TSK_FS_META_TYPE_REG && (meta->flags & TSK_FS_META_FLAG_UNALLOC)) {
+        for (auto *name = meta->name2; name; name = name->next) {
+            if (!strpbrk(name->name, "\r\n")) printf("NAME %s\n", name->name);
+        }
+        const auto *data = tsk_fs_file_attr_get_type(file, TSK_FS_ATTR_TYPE_NTFS_DATA, 0, 0);
+        if (data && !data->name) {
+            const char *storage = "unchecked";
+            if (data->flags & TSK_FS_ATTR_RES) {
+                storage = "resident";
+            } else if ((data->flags & TSK_FS_ATTR_NONRES) && data->nrd.run &&
+                    !(data->flags & (TSK_FS_ATTR_COMP | TSK_FS_ATTR_ENC | TSK_FS_ATTR_SPARSE))) {
+                storage = "runs";
+                for (auto *run = data->nrd.run; run; run = run->next) {
+                    if (run->flags != TSK_FS_ATTR_RUN_FLAG_NONE || !run->addr || !run->len) {
+                        storage = "unchecked";
+                        break;
+                    }
+                }
+            }
+            printf("DATA %u %" PRIdOFF " %s\n", unsigned(data->id), data->size, storage);
+            if (strcmp(storage, "runs") == 0) {
+                for (auto *run = data->nrd.run; run; run = run->next)
+                    printf("RUN %" PRIuDADDR " %" PRIuDADDR "\n", run->addr, run->len);
+            }
+        }
+    }
+    tsk_fs_file_close(file);
+    return 0;
+}
